name: macOS validation

on:
  push:
    branches:
      - main
      - macos
  pull_request:
    paths:
      - '开发空间/**'
      - 'README.md'
      - 'CHANGELOG.md'
      - '操作指导/**'
      - 'docs/**'
      - '.github/workflows/macos.yml'
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build-and-test:
    runs-on: macos-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Run macOS regression suite
        shell: bash
        run: bash '开发空间/scripts/test.sh'

      - name: Build universal delivery package
        shell: bash
        run: bash '开发空间/scripts/build.sh'

      - name: Check delivery artifact
        shell: bash
        run: bash '开发空间/scripts/check-artifact.sh'

      - name: Check whitespace
        shell: bash
        run: git diff --check

      - name: Upload delivery package
        if: success()
        uses: actions/upload-artifact@v4
        with:
          name: qingyue-macos-${{ github.sha }}
          if-no-files-found: error
          path: |
            交付产品/轻阅-macOS-*/轻阅.app
            交付产品/轻阅-macOS-*-交付.zip
            交付产品/轻阅-macOS-*/SHA256SUMS.txt
