<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/Qingyue.Windows/ReadingRenderer*.cs" Link="Production/%(Filename)%(Extension)" />
    <Compile Include="../../src/Qingyue.Windows/MarkdownPreview.cs" Link="Production/MarkdownPreview.cs" />
    <Compile Include="../../src/Qingyue.Windows/RichDocumentMap.cs" Link="Production/RichDocumentMap.cs" />
    <Compile Include="../../src/Qingyue.Windows/ReaderImage*.cs" Link="Production/%(Filename)%(Extension)" />
    <Compile Include="../../src/Qingyue.Windows/ReaderTable*.cs" Link="Production/%(Filename)%(Extension)" />
    <Compile Include="../../src/Qingyue.Windows/MarkdownSyntax.cs" Link="Production/MarkdownSyntax.cs" />
    <Compile Include="../../src/Qingyue.Windows/Mermaid*.cs" Link="Production/%(Filename)%(Extension)" />
    <Compile Include="../../src/Qingyue.Windows/ReadingClipboard.cs" Link="Production/ReadingClipboard.cs" />
    <Compile Include="../../src/Qingyue.Windows/ReadingHtmlExport.cs" Link="Production/ReadingHtmlExport.cs"
             Condition="Exists('../../src/Qingyue.Windows/ReadingHtmlExport.cs')" />
    <ProjectReference Include="../../src/Qingyue.Core/Qingyue.Core.csproj" />
  </ItemGroup>
</Project>
