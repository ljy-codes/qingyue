<DrawingImage xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
  <DrawingImage.Drawing>
    <DrawingGroup>
      <!-- The transparent artboard keeps every export on the same 512-unit grid. -->
      <GeometryDrawing Brush="Transparent">
        <GeometryDrawing.Geometry>
          <RectangleGeometry Rect="0,0,512,512"/>
        </GeometryDrawing.Geometry>
      </GeometryDrawing>

      <!-- Sky blue reading surface. The icon intentionally avoids the former book silhouette. -->
      <GeometryDrawing>
        <GeometryDrawing.Brush>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0.85,1">
            <GradientStop Color="#C7F0FF" Offset="0"/>
            <GradientStop Color="#7198DE" Offset="1"/>
          </LinearGradientBrush>
        </GeometryDrawing.Brush>
        <GeometryDrawing.Geometry>
          <RectangleGeometry Rect="24,24,464,464" RadiusX="124" RadiusY="124"/>
        </GeometryDrawing.Geometry>
      </GeometryDrawing>

      <GeometryDrawing>
        <GeometryDrawing.Brush>
          <RadialGradientBrush Center="0.72,0.46" RadiusX="0.62" RadiusY="0.62">
            <GradientStop Color="#6193D7F1" Offset="0"/>
            <GradientStop Color="#0093D7F1" Offset="1"/>
          </RadialGradientBrush>
        </GeometryDrawing.Brush>
        <GeometryDrawing.Geometry>
          <RectangleGeometry Rect="24,24,464,464" RadiusX="124" RadiusY="124"/>
        </GeometryDrawing.Geometry>
      </GeometryDrawing>

      <!-- Four calm text lines turn the mark into a reading tool rather than a book symbol. -->
      <GeometryDrawing>
        <GeometryDrawing.Brush>
          <SolidColorBrush Color="#31577E" Opacity=".70"/>
        </GeometryDrawing.Brush>
        <GeometryDrawing.Geometry>
          <RectangleGeometry Rect="105,165,235,17" RadiusX="8.5" RadiusY="8.5"/>
        </GeometryDrawing.Geometry>
      </GeometryDrawing>
      <GeometryDrawing>
        <GeometryDrawing.Brush>
          <SolidColorBrush Color="#FF8D6F"/>
        </GeometryDrawing.Brush>
        <GeometryDrawing.Geometry>
          <RectangleGeometry Rect="105,215,285,23" RadiusX="11.5" RadiusY="11.5"/>
        </GeometryDrawing.Geometry>
      </GeometryDrawing>
      <GeometryDrawing>
        <GeometryDrawing.Brush>
          <SolidColorBrush Color="#31577E" Opacity=".60"/>
        </GeometryDrawing.Brush>
        <GeometryDrawing.Geometry>
          <RectangleGeometry Rect="105,277,215,17" RadiusX="8.5" RadiusY="8.5"/>
        </GeometryDrawing.Geometry>
      </GeometryDrawing>
      <GeometryDrawing>
        <GeometryDrawing.Brush>
          <SolidColorBrush Color="#31577E" Opacity=".46"/>
        </GeometryDrawing.Brush>
        <GeometryDrawing.Geometry>
          <RectangleGeometry Rect="105,325,150,17" RadiusX="8.5" RadiusY="8.5"/>
        </GeometryDrawing.Geometry>
      </GeometryDrawing>

      <!-- The marker and sparkle mark the current reading position. -->
      <GeometryDrawing Brush="#55FFD873">
        <GeometryDrawing.Geometry>
          <EllipseGeometry Center="395,226.5" RadiusX="31" RadiusY="31"/>
        </GeometryDrawing.Geometry>
      </GeometryDrawing>
      <GeometryDrawing Brush="#FFD873">
        <GeometryDrawing.Geometry>
          <EllipseGeometry Center="395,226.5" RadiusX="15.5" RadiusY="15.5"/>
        </GeometryDrawing.Geometry>
      </GeometryDrawing>
      <GeometryDrawing Brush="#F2FFFDF0">
        <GeometryDrawing.Geometry>
          <EllipseGeometry Center="389.5,221" RadiusX="4" RadiusY="4"/>
        </GeometryDrawing.Geometry>
      </GeometryDrawing>
      <GeometryDrawing Brush="#C7FFF3B0">
        <GeometryDrawing.Geometry>
          <StreamGeometry>M 428,171 L 431.5,180 L 440.5,183.5 L 431.5,187 L 428,196 L 424.5,187 L 415.5,183.5 L 424.5,180 Z</StreamGeometry>
        </GeometryDrawing.Geometry>
      </GeometryDrawing>
    </DrawingGroup>
  </DrawingImage.Drawing>
</DrawingImage>
