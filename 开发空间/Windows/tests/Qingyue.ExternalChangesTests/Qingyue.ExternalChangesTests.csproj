<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.IO" />
    <Compile Include="../../src/Qingyue.Core/*.cs" Link="Core/%(Filename)%(Extension)" />
    <Compile Include="../../src/Qingyue.Windows/*.cs" Exclude="../../src/Qingyue.Windows/App.xaml.cs" Link="Windows/%(Filename)%(Extension)" />
    <Page Include="../../src/Qingyue.Windows/MainWindow.xaml" Link="MainWindow.xaml" />
    <Page Include="../../src/Qingyue.Windows/Theme.xaml" Link="Theme.xaml" />
    <Resource Include="../../src/Qingyue.Windows/Assets/Qingyue.ico" Link="Assets/Qingyue.ico" />
    <Resource Include="../../src/Qingyue.Windows/Assets/Qingyue.png" Link="Assets/Qingyue.png" />
  </ItemGroup>
</Project>
